generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Product {
  id               String         @id @default(uuid()) @db.Uuid
  sourceUrl        String         @unique @map("source_url")
  sourceSite       String         @default("maxx.ca") @map("source_site")
  sourceId         String?        @map("source_id")
  status           ProductStatus  @default(captured)

  rawTitle         String?        @map("raw_title")
  rawPrice         Decimal?       @map("raw_price") @db.Decimal(10, 2)
  rawDescription   String?        @map("raw_description") @db.Text
  rawVariants      Json?          @map("raw_variants")

  title            String?
  descriptionHtml  String?        @map("description_html") @db.Text
  bulletPoints     Json?          @map("bullet_points")
  seoTitle         String?        @map("seo_title")
  seoDescription   String?        @map("seo_description") @db.Text
  tags             String[]       @default([])
  suggestedPrice   Decimal?       @map("suggested_price") @db.Decimal(10, 2)
  costPrice        Decimal?       @map("cost_price") @db.Decimal(10, 2)
  marketAnalysis   Json?          @map("market_analysis")

  /// Maxx event week grouping (e.g. maxx-event-12345)
  eventWeekKey     String?        @map("event_week_key")
  eventId          String?        @map("event_id")
  eventName        String?        @map("event_name")
  auctionEndsAt    DateTime?      @map("auction_ends_at")
  lotQuantity      Int            @default(1) @map("lot_quantity")

  /// watching | capped | published | won | lost | skipped
  bidStatus        String         @default("watching") @map("bid_status")
  maxBidLot        Decimal?       @map("max_bid_lot") @db.Decimal(10, 2)
  maxBidUnit       Decimal?       @map("max_bid_unit") @db.Decimal(10, 2)
  transportShare   Decimal?       @map("transport_share") @db.Decimal(10, 2)
  dealMath         Json?          @map("deal_math")

  /// Available sellable units (source of truth in Maxx Manager)
  stockQty           Int       @default(0) @map("stock_qty")
  lowStockThreshold  Int       @default(1) @map("low_stock_threshold")
  /// Last known Shopify available qty (may be negative / oversold)
  shopifyAvailableQty Int?     @map("shopify_available_qty")
  /// Variant SKU (Shopify or generated MAXX-…)
  sku                String?   @map("sku")
  /// Real auction cost when won (lot total before premium/transport split)
  actualCostLot      Decimal?  @map("actual_cost_lot") @db.Decimal(10, 2)
  actualCostUnit     Decimal?  @map("actual_cost_unit") @db.Decimal(10, 2)
  assignedTo         String?   @map("assigned_to")
  internalNotes      String?   @map("internal_notes") @db.Text

  shopifyProductId       String?   @unique @map("shopify_product_id")
  shopifyVariantId       String?   @map("shopify_variant_id")
  shopifyInventoryItemId String?   @map("shopify_inventory_item_id")
  shopifyStatus          String?   @map("shopify_status")
  inventorySyncedAt      DateTime? @map("inventory_synced_at")
  errorMessage           String?   @map("error_message") @db.Text

  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  images           ProductImage[]
  movements        InventoryMovement[]

  @@index([status])
  @@index([eventWeekKey])
  @@index([bidStatus])
  @@index([stockQty])
  @@index([assignedTo])
  @@index([sku])
  @@map("products")
}

model ProductImage {
  id         String   @id @default(uuid()) @db.Uuid
  productId  String   @map("product_id") @db.Uuid
  url        String
  width      Int?
  height     Int?
  source     String   @default("maxx")
  score      Float?
  isSelected Boolean  @default(false) @map("is_selected")
  position   Int      @default(0)

  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

/// Stock ledger — no location concept (single pool)
model InventoryMovement {
  id             String   @id @default(uuid()) @db.Uuid
  productId      String   @map("product_id") @db.Uuid
  delta          Int
  quantityAfter  Int      @map("quantity_after")
  /// receive | adjust | sale | win | publish | return | damage | other
  reason         String
  note           String?
  createdBy      String?  @map("created_by")
  shopifyOrderId String?  @map("shopify_order_id")
  /// Line item GID — unique with order for sale idempotency
  shopifyLineItemId String? @map("shopify_line_item_id")
  createdAt      DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([shopifyOrderId, shopifyLineItemId])
  @@index([productId])
  @@index([shopifyOrderId])
  @@index([createdAt])
  @@map("inventory_movements")
}

enum ProductStatus {
  captured
  enriching
  ready
  publishing
  active
  error
}
